  "esp32_classic_hid_last_ok": {
    "message0": "Última operação aceite",
    "tooltip": "Consultar a aceitação local da última operação, sem garantir entrega ou execução. Consultas e atualização automática não mudam este resultado."
  },
  "esp32_classic_hid_last_error": {
    "message0": "Último erro Bluetooth clássico",
    "tooltip": "Ler erros de inicialização, operação ou dispositivo assíncronos. Uma entrada aceita localmente ainda pode falhar na transmissão."
  },
  "esp32_classic_hid_update": {
    "message0": "Atualizar dispositivo Bluetooth clássico",
    "tooltip": "Processar relatórios e callbacks pendentes. É chamado automaticamente no início de loop; continuar em laços longos e evitar bloqueios prolongados."
  },
  "esp32_classic_hid_end": {
    "message0": "Parar dispositivo Bluetooth clássico",
    "tooltip": "Parar e liberar recursos; o mesmo modo poderá reiniciar. Falhas de limpeza preservam o contexto e podem ser tentadas novamente."
  },
  "esp32_classic_hid_disconnect": {
    "message0": "Desligar Bluetooth clássico",
    "tooltip": "Desconectar o host atual mantendo o pareamento. Não para o modo do dispositivo."
  },
  "esp32_classic_hid_unpair": {
    "message0": "Limpar emparelhamento Bluetooth clássico",
    "tooltip": "Apagar as chaves de pareamento e aguardar a conclusão de forma síncrona. Parear novamente depois; não chamar a cada iteração."
  },
