  "toolbox_name": "ESP32 Classic Bluetooth HID",
  "toolbox_categories": [
    "Initialize",
    "Connection status",
    "Connection management",
    "Keyboard",
    "Mouse",
    "Media keys",
    "Generic gamepad",
    "Switch Pro controller"
  ],
  "esp32_classic_hid_begin_keyboard": {
    "message0": "Start Classic Bluetooth keyboard named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_begin_mouse": {
    "message0": "Start Classic Bluetooth mouse named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_begin_combo": {
    "message0": "Start Classic Bluetooth keyboard and mouse named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_begin_media": {
    "message0": "Start Classic Bluetooth media keys named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_begin_gamepad": {
    "message0": "Start Classic Bluetooth generic gamepad named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_begin_switch": {
    "message0": "Start Classic Bluetooth SwitchPro named %1",
    "tooltip": "Start one device mode in setup; select the combo mode for both keyboard and mouse. Original ESP32 and Arduino-ESP32 ≥3.3.10 only. Initialization success is not a connection; the same mode can restart after stop."
  },
  "esp32_classic_hid_connected": {
    "message0": "Classic Bluetooth connected",
    "tooltip": "Read the current connection to the host. Pairing and connection are asynchronous; check this before sending input."
  },
  "esp32_classic_hid_last_init_ok": {
    "message0": "Last initialization succeeded",
    "tooltip": "Read whether the most recent initialization succeeded. This does not mean connected or that the host received input."
  },
  "esp32_classic_hid_last_ok": {
    "message0": "Last operation accepted",
    "tooltip": "Read whether the last operation was accepted locally, not delivered or executed by the host. Queries and automatic update do not change this result."
  },
  "esp32_classic_hid_last_error": {
    "message0": "Classic Bluetooth last error",
    "tooltip": "Read initialization, operation or asynchronous device errors. Accepting input locally does not guarantee later delivery."
  },
  "esp32_classic_hid_update": {
    "message0": "Update Classic Bluetooth device",
    "tooltip": "Process pending reports and device callbacks. Called automatically at the start of loop; call it inside long loops and avoid long blocking delays."
  },
  "esp32_classic_hid_end": {
    "message0": "Stop Classic Bluetooth device",
    "tooltip": "Stop the device and clean up resources; the same mode may then restart. Failed cleanup preserves its context and can be retried by stopping again."
  },
  "esp32_classic_hid_disconnect": {
    "message0": "Disconnect Classic Bluetooth",
    "tooltip": "Disconnect the current host while keeping pairing records. This does not stop the device mode."
  },
  "esp32_classic_hid_unpair": {
    "message0": "Clear Classic Bluetooth pairing",
    "tooltip": "Delete stored pairing keys and wait synchronously for completion; pairing must be repeated afterwards. Do not call on every loop iteration."
  },
