  "esp32_classic_hid_connected": {
    "message0": "Bluetooth clásico conectado",
    "tooltip": "Consultar la conexión actual al anfitrión. Emparejamiento y conexión son asíncronos; comprobar antes de enviar entradas."
  },
  "esp32_classic_hid_last_init_ok": {
    "message0": "Última inicialización correcta",
    "tooltip": "Consultar si la última inicialización tuvo éxito. No confirma conexión ni recepción de entradas por el anfitrión."
  },
  "esp32_classic_hid_last_ok": {
    "message0": "Última operación aceptada",
    "tooltip": "Consultar la aceptación local de la última operación, sin garantizar entrega ni ejecución. Las consultas y la actualización automática no cambian este resultado."
  },
  "esp32_classic_hid_last_error": {
    "message0": "Último error de Bluetooth clásico",
    "tooltip": "Leer errores de inicialización, operación o dispositivo asíncronos. Una entrada aceptada localmente aún puede fallar al transmitirse."
  },
  "esp32_classic_hid_update": {
    "message0": "Actualizar dispositivo Bluetooth clásico",
    "tooltip": "Procesar informes y callbacks pendientes. Se llama al inicio de loop automáticamente; seguir llamando en bucles largos y evitar bloqueos prolongados."
  },
  "esp32_classic_hid_end": {
    "message0": "Detener dispositivo Bluetooth clásico",
    "tooltip": "Detener y liberar recursos; después puede reiniciarse el mismo modo. Si la limpieza falla, conserva el contexto y se puede reintentar."
  },
  "esp32_classic_hid_disconnect": {
    "message0": "Desconectar Bluetooth clásico",
    "tooltip": "Desconectar el anfitrión actual conservando el emparejamiento. No detiene el modo del dispositivo."
  },
  "esp32_classic_hid_unpair": {
    "message0": "Borrar emparejamiento Bluetooth clásico",
    "tooltip": "Borrar las claves de emparejamiento y esperar de forma síncrona. Después hay que emparejar de nuevo; no llamar en cada iteración."
  },
