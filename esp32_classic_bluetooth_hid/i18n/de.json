  "esp32_classic_hid_connected": {
    "message0": "Classic Bluetooth verbunden",
    "tooltip": "Aktuelle Verbindung zum Host abfragen. Koppeln und Verbinden erfolgen asynchron; vor dem Senden prüfen."
  },
  "esp32_classic_hid_last_init_ok": {
    "message0": "Letzte Initialisierung erfolgreich",
    "tooltip": "Ergebnis der letzten Initialisierung abfragen. Dies bestätigt weder eine Verbindung noch den Empfang von Eingaben."
  },
  "esp32_classic_hid_last_ok": {
    "message0": "Letzte Aktion angenommen",
    "tooltip": "Lokale Annahme der letzten Aktion abfragen, nicht Empfang oder Ausführung am Host. Abfragen und automatisches Update ändern das Ergebnis nicht."
  },
  "esp32_classic_hid_last_error": {
    "message0": "Letzter Classic-Bluetooth-Fehler",
    "tooltip": "Initialisierungs-, Aktions- oder asynchrone Gerätefehler lesen. Lokal angenommene Eingaben können später bei der Übertragung scheitern."
  },
  "esp32_classic_hid_update": {
    "message0": "Classic-Bluetooth-Gerät aktualisieren",
    "tooltip": "Ausstehende Berichte und Rückrufe bearbeiten. Wird am Anfang von loop automatisch aufgerufen; in langen Schleifen weiter aufrufen und lange Blockaden vermeiden."
  },
  "esp32_classic_hid_end": {
    "message0": "Classic-Bluetooth-Gerät stoppen",
    "tooltip": "Gerät stoppen und Ressourcen freigeben; danach kann derselbe Modus neu starten. Fehlgeschlagene Bereinigung behält den Kontext und kann erneut versucht werden."
  },
  "esp32_classic_hid_disconnect": {
    "message0": "Classic Bluetooth trennen",
    "tooltip": "Aktuellen Host trennen, Kopplungseinträge behalten. Der Gerätemodus wird nicht gestoppt."
  },
  "esp32_classic_hid_unpair": {
    "message0": "Classic-Bluetooth-Kopplung löschen",
    "tooltip": "Gespeicherte Kopplungsschlüssel löschen und synchron warten. Danach neu koppeln; nicht in jedem Schleifendurchlauf aufrufen."
  },
