    {
      "kind": "category",
      "name": "示例程序",
      "colour": "#7CB342",
      "contents": [
        {
          "kind": "label",
          "text": "《避障》 遇障碍：惊讶→跳跃→后退3步→左转3步"
        },
        {
          "kind": "label",
          "text": "《测距仪》 每2秒串口打印距离(cm)"
        },
        {
          "kind": "label",
          "text": "《跟随》 手靠近15cm内跟随前进"
        },
        {
          "kind": "label",
          "text": "《小跑》 快速小跑，遇障碍停"
        },
        {
          "kind": "label",
          "text": "《生日歌》 唱生日快乐歌并跳舞"
        },
        {
          "kind": "label",
          "text": "《超级玛丽》 演奏马里奥主题曲+地下世界"
        },
        {
          "kind": "label",
          "text": "《欢乐舞蹈》 一段完整的快乐舞蹈"
        },
        {
          "kind": "label",
          "text": "《太空步》 迈克尔·杰克逊成名舞"
        },
        {
          "kind": "label",
          "text": "《单身女郎》 碧昂斯热门单曲配舞"
        },
        {
          "kind": "label",
          "text": "《铃儿响叮当》 圣诞歌"
        },
        {
          "kind": "label",
          "text": "《星战》 星球大战主题曲"
        },
        {
          "kind": "label",
          "text": "《闹钟》 10秒布防后警戒，入侵即报警"
        },
        {
          "kind": "label",
          "text": "《全动作》 依次演示全部动作与歌曲"
        },
        {
          "kind": "label",
          "text": "《检索》 类似跟随的狩猎模式"
        },
        {
          "kind": "label",
          "text": "《简易校准》 固定微调值校准舵机"
        },
        {
          "kind": "label",
          "text": "《复位》 四舵机回中"
        },
        {
          "kind": "label",
          "text": "《校准》 串口按键逐格微调并保存"
        },
        {
          "kind": "label",
          "text": "《串口校准》 串口菜单式校准"
        },
        {
          "kind": "label",
          "text": "对 AI 说「打开示例：名称」即可载入画布（共18个，见 README）"
        }
