  "iboxs31_usbhost_new_key": {
    "message0": "USB キーボードで新しく押されたキーコード",
    "tooltip": "次に押されたキーの HID コードを取り出します。なければ 0。キーは最大 32 個まで溜まるので読むのが遅くても失われません"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "キーコード %1 の文字",
    "tooltip": "HID キーコードを文字（英字・数字・記号・空白・改行）に変換します。「新しく押されたキーコード」で取り出した直後のキーなら、押したときの Shift と CapsLock を使うので Shift+1 は ! になります。その他のキーは空"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "キーコード %1 のキー名",
    "tooltip": "HID キーコードを A、1、Enter、F1、Home、Up、LeftShift、Num5 のようなキー名に変換します。ファンクションキーや矢印キーなど文字にならないキーに使います。不明なコードは空"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "USB キーボードで次に入力された文字",
    "tooltip": "次に打たれた文字を取り出します。Shift と CapsLock で大文字・小文字、記号も入力でき、Enter は改行。なければ空の文字列。文字は溜まるので読むのが遅くても失われません"
  },
