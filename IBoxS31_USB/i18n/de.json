  "iboxs31_usbhost_typing": {
    "message0": "USB-Tastatur getippter Text",
    "tooltip": "Bisher in der aktuellen Zeile getippter Text (vor Eingabe); Rücktaste löscht das letzte Zeichen; bis 127 Zeichen"
  },
  "iboxs31_usbhost_line_ready": {
    "message0": "USB-Tastatur hat eine neue Zeile",
    "tooltip": "Wahr nach dem Drücken von Eingabe, bis die Zeile mit „getippte Zeile holen“ abgeholt wird"
  },
  "iboxs31_usbhost_read_line": {
    "message0": "USB-Tastatur getippte Zeile holen",
    "tooltip": "Holt die mit Eingabe abgeschlossene Zeile (ohne Zeilenumbruch) und löscht sie; vor Eingabe leer"
  },
  "iboxs31_usbhost_clear_input": {
    "message0": "USB-Tastatur Eingabe löschen",
    "tooltip": "Löscht ungelesene Tasten, Zeichen und den getippten Text"
  },
