  "iboxs31_usbhost_new_key": {
    "message0": "USB-Tastatur neu gedrückter Tastencode",
    "tooltip": "Holt den HID-Code der nächsten neu gedrückten Taste, sonst 0; Tasten werden gepuffert (bis 32), langsames Lesen verliert nichts"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "Zeichen zu Tastencode %1",
    "tooltip": "Wandelt einen HID-Tastencode in ein Zeichen (Buchstaben, Ziffern, Sonderzeichen, Leerzeichen, Zeilenumbruch); ist es die gerade mit „neu gedrückter Tastencode“ geholte Taste, gelten Umschalt und Feststelltaste von diesem Druck, also Umschalt+1 ergibt !; andere Tasten ergeben leeren Text"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "Name des Tastencodes %1",
    "tooltip": "Wandelt einen HID-Tastencode in einen Tastennamen wie A, 1, Enter, F1, Home, Up, LeftShift oder Num5; für Tasten ohne Zeichen wie Funktions- und Pfeiltasten; unbekannte Codes ergeben leeren Text"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "USB-Tastatur nächstes getipptes Zeichen",
    "tooltip": "Holt das nächste getippte Zeichen, Groß-/Kleinschreibung über Umschalt und Feststelltaste, auch Sonderzeichen; Eingabe ergibt Zeilenumbruch; leer, wenn nichts da ist. Zeichen werden gepuffert, langsames Lesen verliert nichts"
  },
