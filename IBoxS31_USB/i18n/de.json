  "iboxs31_usbhost_init": {
    "message0": "USB-Host initialisieren, USB-A-Versorgung %1",
    "tooltip": "Startet den USB-Host für Tastatur, Maus und USB-Stick (unter /usb eingehängt, nur FAT32/FAT16). Die 5 V am USB-A kommen über XL9555 P07; ohne Versorgung wird nichts erkannt",
    "args0": [
      {
        "options": [
          [
            "an",
            "true"
          ],
          [
            "aus",
            "false"
          ]
        ]
      }
    ]
  },
