            "FORWARD"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_value": {
    "message0": "USB %1",
    "tooltip": "Mouse X/Y add up the movement (can be zeroed; right and down are positive); the key code is a HID code: a=4…z=29, 1=30…0=39, Enter=40, Space=44; the file count is taken when the drive is plugged in",
    "args0": [
      {
        "options": [
          [
            "mouse X",
            "MX"
          ],
          [
            "mouse Y",
            "MY"
          ],
          [
            "last key code",
            "KEY"
          ],
          [
            "input count",
            "INPUTS"
          ],
          [
            "plug-in count",
            "CONNECTS"
          ],
          [
            "USB drive size MB",
            "MSC_MB"
          ],
          [
            "files in drive root",
            "MSC_FILES"
          ],
          [
            "mouse wheel",
            "WHEEL"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_mouse_zero": {
    "message0": "USB mouse position to zero",
    "tooltip": "Makes the current mouse position X=0, Y=0"
  },
  "iboxs31_usbhost_new_key": {
    "message0": "USB keyboard newly pressed key code",
    "tooltip": "Takes the HID code of the next newly pressed key, or 0; keys are queued (up to 32), so slow reading loses nothing"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "character of key code %1",
    "tooltip": "Turns a HID key code into a character (letters, digits, symbols, space, newline); if it is the key just taken by \"newly pressed key code\", the Shift and Caps Lock state from that press is used, so Shift+1 gives !; other keys give empty text"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "name of key code %1",
    "tooltip": "Turns a HID key code into a key name such as A, 1, Enter, F1, Home, Up, LeftShift or Num5; use it for keys that type no character, like function and arrow keys; unknown codes give empty text"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "USB keyboard next typed character",
    "tooltip": "Takes the next typed character, with case from Shift and Caps Lock and symbols too; Enter gives a newline; empty text when none. Characters are queued, so slow reading loses nothing"
  },
