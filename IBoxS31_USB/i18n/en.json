  "iboxs31_usbhost_typing": {
    "message0": "USB keyboard text being typed",
    "tooltip": "Text typed on the current line so far (before Enter); Backspace removes the last character; up to 127 characters"
  },
  "iboxs31_usbhost_line_ready": {
    "message0": "USB keyboard has a new line",
    "tooltip": "True after Enter is pressed, until the line is taken with \"take the typed line\""
  },
  "iboxs31_usbhost_read_line": {
    "message0": "USB keyboard take the typed line",
    "tooltip": "Takes the line handed over by Enter (without the newline) and clears it; empty text before Enter"
  },
  "iboxs31_usbhost_clear_input": {
    "message0": "USB keyboard clear input",
    "tooltip": "Clears unread keys, characters and the text being typed"
  },
  "iboxs31_usbhost_text": {
    "message0": "USB %1 text",
    "tooltip": "Device type is None/Keyboard/Mouse/Generic; last input looks like \"Key [!] (0x1e) +Shift\" or \"Mouse x=12 y=-3 wheel=0 L1 R0 M0\"; drive info looks like \"7380MB 3files:a.txt\"; raw report is the last keyboard/mouse report in hex, for checking devices that are not understood",
    "args0": [
      {
        "options": [
          [
            "device type",
            "DEVICE"
          ],
          [
            "last input",
            "INPUT"
          ],
          [
            "status",
            "STATUS"
          ],
          [
            "USB drive info",
            "MSC_INFO"
          ],
          [
            "raw report",
            "RAW"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_file_write": {
    "message0": "USB drive %1 file %2 text %3",
    "tooltip": "Write replaces the content, append adds to the end; the path starts at the drive root, and nothing happens without a drive",
    "args0": [
      {
        "options": [
          [
            "write",
            "WRITE"
          ],
          [
            "append",
            "APPEND"
          ]
        ]
      },
      null,
      null
    ]
  },
  "iboxs31_usbhost_file_read": {
    "message0": "USB drive read file %1",
    "tooltip": "Reads a whole text file (up to 8 KB); empty text when the file or the drive is missing"
  },
  "iboxs31_usbhost_file_exists": {
    "message0": "USB drive file %1 exists",
    "tooltip": "True when a drive is plugged in and this file or folder exists"
  },
  "iboxs31_usbhost_file_remove": {
    "message0": "USB drive delete file %1",
    "tooltip": "Deletes this file from the drive"
  }
}
