{
  "toolbox_name": "IBox S31 USB Host",
  "iboxs31_usbhost_init": {
    "message0": "initialize USB host, USB-A power %1",
    "tooltip": "Starts the USB host for a keyboard, mouse and USB drive (mounted at /usb, FAT32/FAT16 only). The USB-A 5 V comes from XL9555 P07; without power nothing is detected",
    "args0": [
      {
        "options": [
          [
            "on",
            "true"
          ],
          [
            "off",
            "false"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_vbus": {
    "message0": "USB-A power %1",
    "tooltip": "Turns the USB-A 5 V on or off by itself; off then on makes the plugged device reconnect",
    "args0": [
      {
        "options": [
          [
            "on",
            "true"
          ],
          [
            "off",
            "false"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_state": {
    "message0": "USB %1",
    "tooltip": "\"state changed\" compares plugging, input and USB drive info with the previous read of this block; the first read is true; \"USB-A powered\" reads XL9555 P07 back to confirm the 5 V is on",
    "args0": [
      {
        "options": [
          [
            "started",
            "STARTED"
          ],
          [
            "keyboard/mouse connected",
            "CONNECTED"
          ],
          [
