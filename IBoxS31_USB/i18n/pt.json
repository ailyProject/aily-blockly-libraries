  "iboxs31_usbhost_mouse_zero": {
    "message0": "posição do mouse USB a zero",
    "tooltip": "A posição atual do mouse passa a ser X=0, Y=0"
  },
  "iboxs31_usbhost_new_key": {
    "message0": "teclado USB código da tecla recém-pressionada",
    "tooltip": "Pega o código HID da próxima tecla pressionada, ou 0; as teclas ficam em fila (até 32), ler devagar não perde nada"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "caractere do código de tecla %1",
    "tooltip": "Converte um código HID em caractere (letras, dígitos, símbolos, espaço, quebra de linha); se for a tecla recém-pega por \"código da tecla recém-pressionada\", usa o Shift e Caps Lock daquele toque, então Shift+1 dá !; outras teclas dão texto vazio"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "nome do código de tecla %1",
    "tooltip": "Converte um código HID em nome de tecla como A, 1, Enter, F1, Home, Up, LeftShift ou Num5; serve para teclas sem caractere como as de função e as setas; códigos desconhecidos dão texto vazio"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "teclado USB próximo caractere digitado",
    "tooltip": "Pega o próximo caractere digitado, com maiúsculas pelo Shift e Caps Lock e também símbolos; Enter dá quebra de linha; texto vazio se não houver. Os caracteres ficam em fila, ler devagar não perde nada"
  },
