{
  "toolbox_name": "IBox S31 Host USB",
  "iboxs31_usbhost_init": {
    "message0": "inicializar host USB, alimentação USB-A %1",
    "tooltip": "Inicia o host USB para teclado, mouse e pendrive (montado em /usb, só FAT32/FAT16). Os 5 V do USB-A vêm pelo XL9555 P07; sem alimentação nada é detectado",
    "args0": [
      {
        "options": [
          [
            "ligada",
            "true"
          ],
          [
            "desligada",
            "false"
          ]
        ]
      }
    ]
  },
  "iboxs31_usbhost_vbus": {
    "message0": "alimentação USB-A %1",
    "tooltip": "Liga ou desliga só os 5 V do USB-A; desligar e ligar faz o dispositivo reconectar",
