  "iboxs31_usbhost_typing": {
    "message0": "teclado USB texto sendo digitado",
    "tooltip": "Texto digitado na linha atual (antes do Enter); Backspace apaga o último caractere; até 127 caracteres"
  },
  "iboxs31_usbhost_line_ready": {
    "message0": "teclado USB tem uma linha nova",
    "tooltip": "Verdadeiro depois do Enter, até a linha ser pega com \"pegar a linha digitada\""
  },
  "iboxs31_usbhost_read_line": {
    "message0": "teclado USB pegar a linha digitada",
    "tooltip": "Pega a linha entregue pelo Enter (sem quebra de linha) e a apaga; vazio antes do Enter"
  },
  "iboxs31_usbhost_clear_input": {
    "message0": "teclado USB limpar entrada",
    "tooltip": "Apaga teclas e caracteres não lidos e o texto sendo digitado"
  },
  "iboxs31_usbhost_text": {
    "message0": "texto USB %1",
    "tooltip": "Tipo de dispositivo None/Keyboard/Mouse/Generic; última entrada como \"Key [!] (0x1e) +Shift\" ou \"Mouse x=12 y=-3 wheel=0 L1 R0 M0\"; info do pendrive como \"7380MB 3files:a.txt\"; o relatório bruto é o último relatório de teclado/mouse em hexadecimal, para verificar dispositivos não reconhecidos",
