  "iboxs31_usbhost_new_key": {
    "message0": "لوحة مفاتيح USB رمز المفتاح المضغوط حديثًا",
    "tooltip": "يأخذ رمز HID للمفتاح التالي المضغوط، أو 0؛ المفاتيح تُصفّ (حتى 32) فلا يضيع شيء مع القراءة البطيئة"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "حرف رمز المفتاح %1",
    "tooltip": "يحوّل رمز HID إلى حرف (أحرف وأرقام ورموز ومسافة وسطر جديد)؛ إذا كان المفتاح الذي أُخذ للتو بكتلة \"رمز المفتاح المضغوط حديثًا\" يُستخدم Shift وCaps Lock لتلك الضغطة فيعطي Shift+1 علامة !؛ المفاتيح الأخرى تعطي نصًا فارغًا"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "اسم رمز المفتاح %1",
    "tooltip": "يحوّل رمز HID إلى اسم مفتاح مثل A و1 وEnter وF1 وHome وUp وLeftShift وNum5؛ للمفاتيح التي لا تكتب حرفًا مثل مفاتيح الوظائف والأسهم؛ الرموز غير المعروفة تعطي نصًا فارغًا"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "لوحة مفاتيح USB الحرف المكتوب التالي",
    "tooltip": "يأخذ الحرف المكتوب التالي بأحرف كبيرة/صغيرة حسب Shift وCaps Lock ومع الرموز؛ Enter يعطي سطرًا جديدًا؛ نص فارغ إن لم يوجد. الحروف تُصفّ فلا يضيع شيء مع القراءة البطيئة"
  },
