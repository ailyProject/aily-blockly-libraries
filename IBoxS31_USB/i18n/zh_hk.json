  "iboxs31_usbhost_mouse_zero": {
    "message0": "USB 滑鼠位置清零",
    "tooltip": "把目前滑鼠位置記為 X=0、Y=0"
  },
  "iboxs31_usbhost_new_key": {
    "message0": "USB 鍵盤新按下的按鍵碼",
    "tooltip": "取出下一個新按下的鍵的 HID 碼，沒有就是 0；按鍵會排隊（最多 32 個），讀得慢也不會漏"
  },
  "iboxs31_usbhost_key_char": {
    "message0": "按鍵碼 %1 對應的字元",
    "tooltip": "把 HID 按鍵碼轉成字元（小寫字母、數字、符號、空格、換行）；如果正是「新按下的按鍵碼」剛取出的那個鍵，就按它按下時的 Shift 和大寫鎖定來轉，例如 Shift+1 得到 !；其他鍵回傳空文字"
  },
  "iboxs31_usbhost_key_name": {
    "message0": "按鍵碼 %1 的鍵名",
    "tooltip": "把 HID 按鍵碼轉成鍵名，如 A、1、Enter、F1、Home、Up、LeftShift、Num5；功能鍵、方向鍵這些打不出字元的鍵用它；不認識的碼回傳空文字"
  },
  "iboxs31_usbhost_new_char": {
    "message0": "USB 鍵盤新輸入的字元",
    "tooltip": "取出下一個打出來的字元，按 Shift、大寫鎖定區分大小寫，也能打出符號，Enter 是換行；沒有就是空文字。字元會排隊，讀得慢也不會漏"
  },
