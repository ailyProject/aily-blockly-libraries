      "inputs": {
        "THRESHOLD": {
          "shadow": {
            "type": "math_number",
            "fields": {
              "NUM": 3
            }
          }
        }
      }
    },
    {
      "kind": "block",
      "type": "espsleep_esp32_disable_wakeup",
      "fields": {
