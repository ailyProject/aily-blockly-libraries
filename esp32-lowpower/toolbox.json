          }
        }
      }
    },
    {
      "kind": "block",
      "type": "espsleep_esp32_set_rtc",
      "fields": {
        "VAR_NAME": "rtcCounter"
      },
      "inputs": {
        "VALUE": {
          "shadow": {
            "type": "math_number",
            "fields": {
              "NUM": 0
            }
          }
        }
      }
    },
    {
      "kind": "block",
      "type": "espsleep_esp32_get_rtc",
      "fields": {
        "VAR_NAME": "rtcCounter"
      }
    },
    {
      "kind": "label",
