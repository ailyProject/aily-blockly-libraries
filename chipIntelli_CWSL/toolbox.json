{
  "kind": "category",
  "name": "命令词自学习",
  "icon": "fa-light fa-microphone-lines",
  "colour": "#2E7D32",
  "contents": [
    {
      "kind": "label",
      "text": "完整语音学习（推荐）"
    },
    {
      "kind": "block",
      "type": "chipintelli_cwsl_voice_learning_init",
      "inputs": {
        "COMMAND_ID": {
          "shadow": {
            "type": "chipintelli_asr_command_fixed_id",
            "fields": {
              "TEXT": "执行操作",
              "COMMAND_ID": 1000
            }
          }
        },
        "WAKE_ID": {
          "shadow": {
            "type": "chipintelli_asr_command_id",
            "fields": {
              "COMMAND_ID": 1
            }
          }
        },
        "GROUP_ID": {
          "shadow": {
            "type": "math_number",
            "fields": {
              "NUM": 0
            }
          }
        },
        "COMMAND_PROMPT": {
          "shadow": {
            "type": "chipintelli_audio_voice",
            "fields": {
              "TEXT": "提示结束后，说出新的命令短语。没有听到结果时，请间隔两秒重复。"
            }
          }
        },
        "WAKE_PROMPT": {
          "shadow": {
            "type": "chipintelli_audio_voice",
            "fields": {
              "TEXT": "提示结束后，说出新的唤醒短语。没有听到结果时，请间隔两秒重复。"
            }
          }
        },
        "SUCCESS_PROMPT": {
          "shadow": {
            "type": "chipintelli_audio_voice",
            "fields": {
              "TEXT": "操作成功，已经保存。"
            }
          }
        },
        "FAILURE_PROMPT": {
          "shadow": {
            "type": "chipintelli_audio_voice",
            "fields": {
              "TEXT": "操作失败。如果再次学习仍然失败，请重新上电并换一个短语。"
            }
          }
        }
      }
    },
    {
      "kind": "block",
      "type": "chipintelli_cwsl_voice_learning_request"
    },
    {
      "kind": "block",
      "type": "chipintelli_cwsl_voice_learning_busy"
    },
    {
      "kind": "block",
      "type": "chipintelli_cwsl_voice_learning_ready"
    },
    {
      "kind": "block",
      "type": "chipintelli_cwsl_voice_learning_error"
    },
    {
      "kind": "label",
      "text": "底层接口（不要与控制器混用）"
    },
    {"kind": "label", "text": "初始化"},
    {"kind": "block", "type": "chipintelli_cwsl_init", "inputs": {"TIMEOUT": {"shadow": {"type": "math_number", "fields": {"NUM": 10000}}}}},
    {"kind": "block", "type": "chipintelli_cwsl_is_begun"},
    {"kind": "block", "type": "chipintelli_cwsl_profile_enabled"},
    {"kind": "block", "type": "chipintelli_cwsl_end"},
    {"kind": "label", "text": "学习与删除"},
    {"kind": "block", "type": "chipintelli_cwsl_learn", "inputs": {"COMMAND_ID": {"shadow": {"type": "math_number", "fields": {"NUM": 2}}}, "GROUP_ID": {"shadow": {"type": "math_number", "fields": {"NUM": 0}}}}},
    {"kind": "block", "type": "chipintelli_cwsl_cancel_learning"},
    {"kind": "block", "type": "chipintelli_cwsl_erase_template", "inputs": {"COMMAND_ID": {"shadow": {"type": "math_number", "fields": {"NUM": 2}}}, "GROUP_ID": {"shadow": {"type": "math_number", "fields": {"NUM": 0}}}}},
    {"kind": "block", "type": "chipintelli_cwsl_erase_templates"},
    {"kind": "label", "text": "状态与容量"},
    {"kind": "block", "type": "chipintelli_cwsl_state"},
    {"kind": "block", "type": "chipintelli_cwsl_state_value"},
    {"kind": "block", "type": "chipintelli_cwsl_count"},
    {"kind": "label", "text": "异步事件"},
    {"kind": "block", "type": "chipintelli_cwsl_read_events"},
    {"kind": "block", "type": "chipintelli_cwsl_event_type"},
    {"kind": "block", "type": "chipintelli_cwsl_event_type_value"},
    {"kind": "block", "type": "chipintelli_cwsl_event_command_id"},
    {"kind": "block", "type": "chipintelli_cwsl_event_name"},
    {"kind": "block", "type": "chipintelli_cwsl_event_word_type"},
    {"kind": "block", "type": "chipintelli_cwsl_word_type_value"},
    {"kind": "block", "type": "chipintelli_cwsl_event_attempt"},
    {"kind": "block", "type": "chipintelli_cwsl_event_result"},
    {"kind": "block", "type": "chipintelli_cwsl_learn_result_value"},
    {"kind": "block", "type": "chipintelli_cwsl_event_group_id"},
    {"kind": "block", "type": "chipintelli_cwsl_event_distance"},
    {"kind": "label", "text": "诊断与事件队列"},
    {"kind": "block", "type": "chipintelli_cwsl_last_error"},
    {"kind": "block", "type": "chipintelli_cwsl_error_value"},
    {"kind": "block", "type": "chipintelli_cwsl_error_string"},
    {"kind": "block", "type": "chipintelli_cwsl_state_name"},
    {"kind": "block", "type": "chipintelli_cwsl_available"},
    {"kind": "block", "type": "chipintelli_cwsl_pending_events"},
    {"kind": "block", "type": "chipintelli_cwsl_clear_events"},
    {"kind": "block", "type": "chipintelli_cwsl_dropped_read_events"},
    {"kind": "block", "type": "chipintelli_cwsl_dropped_callback_events"},
    {"kind": "block", "type": "chipintelli_cwsl_dropped_events"}
  ]
}
