  "toolbox_name": "ESP32 USB-хост",
  "esp32_usb_host_init": {
    "message0": "инициализировать USB-хост",
    "tooltip": "Запускает USB-хост для клавиатуры, мыши и флешки (монтируется в /usb, только FAT32/FAT16). Питание порта не включает: на IBox S31 сначала сделайте XL9555 P07 выходом с уровнем 1; без питания ничего не определяется"
  },
