  "esp32_usb_host_typing": {
    "message0": "USB-клавиатура набираемый текст",
    "tooltip": "Текст, набранный в текущей строке (до Enter); Backspace стирает последний символ; до 127 символов"
  },
  "esp32_usb_host_line_ready": {
    "message0": "USB-клавиатура есть новая строка",
    "tooltip": "Истина после нажатия Enter, пока строку не заберут блоком «взять введённую строку»"
  },
  "esp32_usb_host_read_line": {
    "message0": "USB-клавиатура взять введённую строку",
    "tooltip": "Забирает строку, завершённую Enter (без перевода строки), и очищает её; до Enter — пусто"
  },
  "esp32_usb_host_clear_input": {
    "message0": "USB-клавиатура очистить ввод",
    "tooltip": "Стирает непрочитанные клавиши, символы и набираемый текст"
  },
