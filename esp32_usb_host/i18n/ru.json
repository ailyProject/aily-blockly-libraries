  "esp32_usb_host_mouse_zero": {
    "message0": "обнулить позицию USB-мыши",
    "tooltip": "Текущая позиция мыши становится X=0, Y=0"
  },
  "esp32_usb_host_new_key": {
    "message0": "USB-клавиатура код новой нажатой клавиши",
    "tooltip": "Забирает HID-код следующей нажатой клавиши, иначе 0; клавиши стоят в очереди (до 32), медленное чтение ничего не теряет"
  },
  "esp32_usb_host_key_char": {
    "message0": "символ кода клавиши %1",
    "tooltip": "Переводит HID-код в символ (буквы, цифры, знаки, пробел, перевод строки); если это клавиша, только что взятая блоком «код новой нажатой клавиши», учитываются Shift и Caps Lock того нажатия, так Shift+1 даёт !; для других клавиш — пустой текст"
  },
  "esp32_usb_host_key_name": {
    "message0": "имя клавиши с кодом %1",
    "tooltip": "Переводит HID-код в имя клавиши: A, 1, Enter, F1, Home, Up, LeftShift, Num5; для клавиш без символа, например функциональных и стрелок; для неизвестных кодов — пустой текст"
  },
  "esp32_usb_host_new_char": {
    "message0": "USB-клавиатура следующий введённый символ",
    "tooltip": "Берёт следующий введённый символ с учётом Shift и Caps Lock, включая знаки; Enter даёт перевод строки; пустой текст, если ничего нет. Символы стоят в очереди, медленное чтение ничего не теряет"
  },
