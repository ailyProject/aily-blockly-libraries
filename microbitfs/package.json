{
  "name": "@aily-project/lib-microbitfs",
  "nickname": "micro:bit V2 文件系统（microbitfs）",
  "description": "micro:bit V2 文件系统积木库：完整移植 micropython-microbit-v2 的 microbitfs（128B chunk 链表文件系统，窗口 0x6D000-0x73000，随机轮转磨损均衡、页交换碎片整理、掉电安全），封装层扩展虚拟文件夹操作。强调：只能操作20kb空间，存个参数吧，更多的没啥用。在电脑里看到的64M是假的，感觉天天在上当，当当不一样!!!",
  "version": "1.1.0",
  "author": "ajie5211",
  "license": "MIT",
  "main": "generator.js",
  "compatibility": {
    "core": [
      "n-able-Arduino:arm-ble:BBCmicrobitV2"
    ],
    "voltage": [
      3.3
    ]
  },
  "keywords": [
    "aily",
    "blockly",
    "microbitfs",
    "microbit",
    "文件系统",
