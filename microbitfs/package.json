    "microbitfs_line_count",
    "microbitfs_exists",
    "microbitfs_file_size",
    "microbitfs_remove",
    "microbitfs_list_files",
    "microbitfs_file_count",
    "microbitfs_free_kb",
    "microbitfs_used_kb",
    "microbitfs_dir_exists",
    "microbitfs_dir_list",
    "microbitfs_dir_file_count",
    "microbitfs_dir_remove"
  ],
  "tags": [
