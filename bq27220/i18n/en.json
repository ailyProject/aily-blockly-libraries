  "bq27220_voltage_percent": {
    "message0": "%1 charge estimated from voltage",
    "tooltip": "0–100: the voltage is smoothed (about 1 s) and mapped on a single-cell Li-ion curve (3.3 V = 0%, 3.8 V ≈ 50%, 4.2 V = 100%) with 2% hysteresis; sampled every 100 ms at the start of loop. Use it when the gauge is not calibrated (e.g. IBox S31) and its own charge is wrong"
  },
  "bq27220_battery_state": {
    "message0": "%1 battery %2",
    "tooltip": "Low: the voltage-based charge is 10% or less; should shut down: the smoothed voltage has stayed below 3.3 V for about 3 s. Sampled every 100 ms at the start of loop, so avoid long delays",
