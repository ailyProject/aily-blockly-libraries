      null,
      {
        "options": [
          [
            "low",
            "LOW"
          ],
          [
            "should shut down",
            "SHUTDOWN"
          ]
        ]
      }
    ]
  },
  "bq27220_deep_sleep": {
    "message0": "enter deep sleep to shut down",
    "tooltip": "Last step of low-voltage protection: the ESP32 enters deep sleep and restarts after plugging in power or pressing reset. Turn off the amplifier, lights and other loads first"
